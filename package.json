{
  "name": "opencode-codebuddy-auth",
  "version": "1.1.0",
  "description": "OpenCode plugin for CodeBuddy (IOA) authentication",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts",
      "config": {
        "enabled": true
      }
    }
  },
  "scripts": {
    "build": "tsc && node build.tui.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.16"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.0",
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/node": "^25.6.0",
    "esbuild": "^0.25.12",
    "esbuild-plugin-solid": "^0.5.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "keywords": [
    "opencode",
    "plugin",
    "codebuddy",
    "ioa",
    "authentication"
  ],
  "files": [
    "dist",
    "opencode-v2.md",
    "images"
  ]
}
